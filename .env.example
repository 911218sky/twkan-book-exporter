# 複製為 .env 後生效；不設定時仍使用下列預設值。
# 本機服務僅綁定 localhost，不建議改成 0.0.0.0。
CAMOFOX_BIND_HOST=127.0.0.1

# 關閉 Camofox 的匿名錯誤回報，避免爬蟲產生額外網路流量。
CAMOFOX_CRASH_REPORT_ENABLED=false

# 單一瀏覽器閒置多久後自動關閉，單位為毫秒。
BROWSER_IDLE_TIMEOUT_MS=10000

# 資源與穩定性的預設上限：最多 3 個分頁、1 個 session。
MAX_CONCURRENT_PER_USER=3
MAX_TABS_GLOBAL=3
MAX_TABS_PER_SESSION=3
MAX_SESSIONS=1

# session 與沒有操作的分頁多久過期，單位為毫秒。
SESSION_TIMEOUT_MS=60000
TAB_INACTIVITY_MS=60000
